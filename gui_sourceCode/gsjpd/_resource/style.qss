
QMainWindow,
QWidget[style="window"]
{
    color: palette(window-text);
    background-color: palette(window);
}

/* ツールバー */
QToolBar {
    border: none;
    padding: 0px;
}
QToolButton {
    border: none;
    padding: 1px 6px;
    background-color: palette(window);
}
QToolButton:hover {
    background-color: palette(button);
}
QToolButton:pressed {
    background-color: palette(window);
}

/* タブ */
QTabWidget { 
    background-color: palette(window);
}
QTabWidget QTabBar::tab {
    border-radius: 3px 3px 0px 0px; 
    padding: 4px 8px;
    border-top: 2px solid transparent;
    border-bottom: 0px solid transparent;
    border-left: 1px solid transparent;
    border-right: 1px solid transparent;    
}
QTabWidget QTabBar::tab:selected {
    color: palette(window-text);
    background-color: palette(light);
    border-top: 2px solid palette(highlight);
}
QTabWidget QTabBar::tab:!selected {
    color: palette(window-text);
    background-color: rgba(127, 127, 127, 10%);
}

QTabWidget[style="main"] QTabBar::tab { 
    padding: 6px 24px;
    min-width: 100px;
}

/* グループボックス */
QGroupBox {
    margin-top: 1.1em;
    border: none; 
    border-radius: 2px; 
    background-color: palette(button);
    font-weight: bold;
    padding: 4px 8px;
}           
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
}  

/* ボタン */
QPushButton { 
    color: palette(button-text);
    background-color: palette(button);
    border: none;  
    padding: 0.25em 0.25em;
    min-width: 64px;
}
QPushButton:hover { 
    background-color: palette(light); 
}
QPushButton:disabled { 
    color: palette(dark);
}

QPushButton[style="primary"] { 
    color: rgba(255, 255, 255, 100%);
    background-color: rgba(0, 148, 200, 90%);  
    padding: 0.25em 1.25em;
}
QPushButton[style="primary"]:hover { 
    background-color: rgba(0, 148, 200, 100%); 
}
QPushButton[style="primary"]:pressed { 
    background-color: rgba(0, 148, 200, 80%);  
}  
QPushButton[style="primary"]:disabled { 
    background-color: rgba(0, 148, 200, 40%);  
}  
 
QPushButton[style="secondary"] { 
    color: rgba(255, 255, 255, 100%);
    background-color: rgba(127, 127, 127, 90%);  
    padding: 0.25em 1.25em;
}
QPushButton[style="secondary"]:hover { 
    background-color: rgba(127, 127, 127, 100%);  
}
QPushButton[style="secondary"]:pressed { 
    background-color: rgba(127, 127, 127, 80%);  
}  
QPushButton[style="secondary"]:disabled { 
    background-color: rgba(127, 127, 127, 40%);  
}  
 
QPushButton[style="danger"] { 
    color: rgba(255, 255, 255, 100%);
    background-color: rgba(203, 85, 97, 90%);
    padding: 0.25em 1.25em;
}
QPushButton[style="danger"]:hover { 
    background-color: rgba(203, 85, 97, 100%);
}
QPushButton[style="danger"]:pressed { 
    background-color: rgba(203, 85, 97, 80%);
}  
QPushButton[style="danger"]:disabled { 
    background-color: rgba(203, 85, 97, 40%);
} 

QPushButton[style="small"] {
    color: palette(button-text);
    background-color: palette(transparent);
    border-color: palette(transparent);
    border-radius: 3px;
    border-width: 1px;
    padding: 0.1em 0.5em;
    min-width: 8px;
}
QPushButton[style="small"]:hover { 
    color: rgba(255, 255, 255, 100%);
    background-color: rgba(0, 148, 200, 60%); 
    border-color: rgba(0, 148, 200, 60%); 
}
QPushButton[style="small"]:pressed { 
    color: rgba(255, 255, 255, 100%);
    background-color: rgba(0, 148, 200, 50%); 
    border-color: rgba(0, 148, 200, 50%); 
}  
QPushButton[style="small"]:disabled { 
    background-color: palette(button);
}  

QWidget.ModelListHeaderRow QPushButton {
    text-align: left;
    padding-left: 6px;
}

/* ラベル */
QLabel { 
    color: palette(window-text);
}
QLabel[style="property"] { 
    min-width: 100px;
    min-height: 1.25em;
    padding: 0em 0.25em;
}
QLabel[style="listitem"] { 
}
QWidget.ModelListItemRow QLabel {
    padding: 0em 0.1em;
}

.ConfigDialog QLabel[style="property"] { 
    min-width: 160px;
    padding: 0em 0.25em;
}

/* チェックボックス */
QCheckBox { 
    color: palette(window-text);
    padding: 0.2em 0.25em 0em, 0.5em;
    min-height: 1.25em;
}

/* エディットボックス */
QLineEdit { 
    border-top: 1px solid transparent; 
    border-left: 1px solid transparent; 
    border-right: 1px solid transparent; 
    border-bottom: 1px solid palette(mid); 
    border-radius: 3px;      
    color: palette(window-text);
    padding: 0.1em; 
}
QLineEdit:disabled {
    border-bottom: 1px solid transparent; 
    color: palette(window-text);
    background-color: palette(base); 
}

QLineEdit[state="required"] {
    placeholder-text-color: rgba(203, 85, 97, 90%);
}

QTextEdit { 
    padding: 0.1em; 
    border-top: 1px solid transparent; 
    border-left: 1px solid transparent; 
    border-right: 1px solid transparent; 
    border-bottom: 1px solid palette(mid); 
    border-radius: 3px;      
}
QTextEdit:disabled {
    border-bottom: 1px solid transparent; 
    color: palette(window-text);
    background-color: palette(base); 
}




/* リスト */
QListWidget {
    background-color: palette(button);
}

/* コンボボックス */
QComboBox {
    padding: 0.1em 0.2em; 
    border-top: 1px solid transparent; 
    border-left: 1px solid transparent; 
    border-right: 1px solid transparent; 
    border-bottom: 1px solid palette(mid); 
    border-radius: 3px;
}
QComboBox::drop-down {
    width: 15px;
    color: palette(button-text);
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}
QComboBox::down-arrow {
    image: url(:/icons/down-arrow.png);
    width: 10px;
    height: 10px;
}
QComboBox:disabled {
    border-bottom: 1px solid transparent; 
    color: palette(window-text);
    background-color: palette(base); 
}
QComboBox::drop-down:disabled {
}
QComboBox::down-arrow:disabled {
    image: none;
}

/* QPlainTextEdit */
QPlainTextEdit {
    border: none;
    border-radius: 2px;
}
QPlainTextEdit[style="console"] {
    color: rgba(223, 223, 223, 100%);
    background-color: rgba(79, 79, 79, 100%);
}